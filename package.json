{
  "name": "personal-ai-design",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && vite build src/workbench --outDir ../../dist/workbench",
    "test": "tsx --test tests/*.test.ts",
    "demo": "tsx examples/core-demo.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "tsx src/server/dev.ts",
    "agent-submit": "tsx src/server/agent-submit.ts",
    "agent-task": "tsx src/server/agent-task.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "ajv": "8.20.0",
    "class-variance-authority": "0.7.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
